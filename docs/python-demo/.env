# Python Demo 运行配置（目标：Nano 部署节点）
# 从 .env.example 复制并填写；由 run.sh 加载为环境变量

# ── 服务地址（Nano 部署节点）──
YOOX_SERVER_IP=172.20.10.4
YOOX_SERVER_PORT=9000
# 使用反向代理/TLS 时可直接覆盖完整地址：
# YOOX_BASE_URL=https://gcs.example.com
# YOOX_WS_URL=wss://gcs.example.com/api/v1/ws

# ── 登录账号 ──
YOOX_WEB_USERNAME=admin
YOOX_WEB_PASSWORD=Yoox@123456
YOOX_WEB_FLAG=1

YOOX_PILOT_USERNAME=pilot
YOOX_PILOT_PASSWORD=pilot123
YOOX_PILOT_FLAG=2

# ── 工作空间（数据库初始化固定值）──
YOOX_WORKSPACE_ID=e3dea0f5-37f2-4d79-ae58-490af3228069

# ── 设备标识（Nano 全新数据库，设备连接后运行 demo_02 获取实际值填回）──
YOOX_DOCK_SN=YOUR_DOCK_SN
YOOX_DRONE_SN=YOUR_DRONE_SN
YOOX_PAYLOAD_INDEX=YOUR_PAYLOAD_INDEX

# ── MQTT（MQTT_HOST 默认跟随 YOOX_SERVER_IP，无需单独配置）──
YOOX_MQTT_PORT=1883
YOOX_MQTT_WS_PORT=9001
YOOX_MQTT_USERNAME=admin
YOOX_MQTT_PASSWORD=admin

# ── RTSP 拉流 ──
YOOX_RTSP_PORT=8554

# ── 点飞/起飞目标（demo_08/10 前必须填写有效 GPS 坐标）──
YOOX_TARGET_LATITUDE=
YOOX_TARGET_LONGITUDE=
YOOX_TARGET_HEIGHT=
YOOX_TARGET_MAX_SPEED=5

# ── 超时（秒）──
YOOX_HTTP_CONNECT_TIMEOUT=5
YOOX_HTTP_CONTROL_TIMEOUT=20
YOOX_POINT_FLIGHT_WAIT_SECONDS=300
