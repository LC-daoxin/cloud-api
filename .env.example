# Cloud-API 环境变量模板
#
# 用途：
#   1. 单机 Docker Compose（docker-compose.yml）本地开发/测试：可以不创建 .env，
#      所有变量均有默认值，行为与改造前完全一致。
#   2. 多节点独立部署（docker-compose.nano.yml，配合每台 Jetson Nano）：
#      复制此文件为 .env，按下方说明为每个节点填入独立的值。
#
# 使用方式：
#   cp .env.example .env
#   vim .env   # 按节点修改 NODE_LAN_IP 等值
#   docker compose -f docker-compose.nano.yml --env-file .env up -d
#
# 安全提示：.env 包含明文密码，不要提交到 git（已在 .gitignore 中排除）。

# ------------------------------------------------------------------
# 节点标识（多节点部署时必填，每台 Nano 不同）
# ------------------------------------------------------------------
# 本节点固定局域网 IP，用于对外（Pilot App / 遥控器 / 无人机）暴露 MQTT 和 OSS 地址
NODE_LAN_IP=192.168.3.1

# ------------------------------------------------------------------
# 数据库（建议多节点部署时至少修改密码）
# ------------------------------------------------------------------
DB_NAME=cloud_sample
DB_USER=uav_cloud
DB_PASSWORD=devpass
MYSQL_ROOT_PASSWORD=devroot

# ------------------------------------------------------------------
# Redis（如需密码可自行在 mosquitto/redis 命令行追加 --requirepass 并在此同步）
# ------------------------------------------------------------------
REDIS_PASSWORD=

# ------------------------------------------------------------------
# 对象存储 / MinIO
# ------------------------------------------------------------------
OSS_ACCESS_KEY=minioadmin
OSS_SECRET_KEY=minioadmin

# ------------------------------------------------------------------
# JWT 签名密钥：生产/多节点部署必须为每个节点设置不同的随机值（至少 32 位）
# 生成示例：openssl rand -base64 32
# ------------------------------------------------------------------
JWT_SECRET=dev-local-secret-replace-in-production-32chars

# ------------------------------------------------------------------
# RTSP 推流鉴权（如设备/第三方推流客户端需要）
# ------------------------------------------------------------------
RTSP_USERNAME=admin
RTSP_PASSWORD=admin

# ------------------------------------------------------------------
# 应用镜像 tag（4 个节点共用同一镜像，见部署手册"镜像构建与分发"）
# ------------------------------------------------------------------
APP_IMAGE=uav-cloud-api-app:1.10.0
