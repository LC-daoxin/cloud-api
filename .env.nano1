# Cloud-API Nano 部署环境变量（4 节点统一标准值）
# 部署新节点时：复制本文件，只需修改 NODE_LAN_IP 为目标 Nano 的固定局域网 IP
# 注意：本文件含明文密码，已在 .gitignore 中排除，不要提交到 Git

# 节点标识（唯一需要按节点修改的变量）
NODE_LAN_IP=172.20.10.4

# 数据库（4 节点统一）
DB_NAME=cloud_sample
DB_USER=uav_cloud
DB_PASSWORD=aJdYOA3FgQbEnJHA7mKgwol4
MYSQL_ROOT_PASSWORD=aJdYOA3FgQbEnJHA7mKgwol4

# Redis（当前未启用密码，保持为空）
REDIS_PASSWORD=

# 对象存储 / MinIO（4 节点统一）
OSS_ACCESS_KEY=nano4minio
OSS_SECRET_KEY=5GzBQXzFsfjeA/9loM97miRA

# JWT 签名密钥（4 节点统一；副作用：同一用户在各节点的 token 可互换，
# 因为 4 个节点的数据库初始 user_id/workspace_id 完全相同，内网项目可接受）
JWT_SECRET=YlTbDRMpqbv0dRMJvE2WY/XKMsVofyDbxf2fVKoJKAY=

# RTSP 推流鉴权
RTSP_USERNAME=admin
RTSP_PASSWORD=admin

# 应用镜像
APP_IMAGE=uav-cloud-api-app:nano1-3f9cb17
